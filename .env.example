DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/business_crawler
APP_ENV=local
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
DEFAULT_USER_AGENT=BusinessCrawlerBot/1.0 contact:your-email@example.com

# Playwright Browser (Optional)
BRAVE_EXECUTABLE_PATH=/usr/bin/brave-browser
ENABLED_PROVIDERS='["masothue", "gdt"]'
CACHE_ACTIVE_DAYS=30
CACHE_INACTIVE_DAYS=7
CACHE_INCOMPLETE_DAYS=1
ALLOW_MANUAL_CAPTCHA=false
MAX_CONCURRENT_PROVIDERS=3
STORE_RAW_HTML=false
RAW_HTML_STORAGE_DIR=./storage/raw_snapshots
