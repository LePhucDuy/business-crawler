# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=business_crawler
POSTGRES_PORT=5432
POSTGRES_HOST=host.docker.internal

# URL dùng cho local development (chạy code trực tiếp không qua docker)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
APP_ENV=local
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
DEFAULT_USER_AGENT=BusinessCrawlerBot/1.0 contact:your-email@example.com

# Playwright Browser
# Nếu chạy trên server không có Brave, hãy comment dòng dưới đây lại 
# và chạy lệnh: `playwright install chromium` để cài đặt trình duyệt mặc định của Playwright.
BRAVE_EXECUTABLE_PATH=/usr/bin/brave-browser
ENABLED_PROVIDERS='["masothue", "gdt"]'
CACHE_ACTIVE_DAYS=3
CACHE_INACTIVE_DAYS=3
CACHE_INCOMPLETE_DAYS=1
ALLOW_MANUAL_CAPTCHA=false
MAX_CONCURRENT_PROVIDERS=3
STORE_RAW_HTML=false
RAW_HTML_STORAGE_DIR=./storage/raw_snapshots

# Chiến lược cào:
# "fallback": Chạy từng web một theo thứ tự trên. Web nào có data thì dừng luôn, tiết kiệm tài nguyên.
# "parallel": Chạy song song tất cả các web cùng lúc (bào tài nguyên hơn nhưng đầy đủ để so sánh chéo).
CRAWL_STRATEGY=fallback